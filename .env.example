# Public URL or IP of the Oracle host, without a trailing slash.
PUBLIC_URL=http://YOUR_ORACLE_PUBLIC_IP

# Vendure and PostgreSQL
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=replace-with-a-long-random-password
COOKIE_SECRET=replace-with-a-long-random-secret
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-a-long-random-password
REVALIDATION_SECRET=replace-with-a-long-random-secret
DEMO_FAILURE_TOKEN=replace-with-a-long-random-secret

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SYNTHETIC_TRAFFIC=false
POSTHOG_PROJECT_ID=replace_me
POSTHOG_PERSONAL_API_KEY=phx_replace_me

# New Relic OpenTelemetry ingest and evidence queries
NEW_RELIC_LICENSE_KEY=replace_me
NEW_RELIC_ACCOUNT_ID=replace_me
NEW_RELIC_USER_API_KEY=NRAK-replace_me
NEW_RELIC_OTLP_ENDPOINT=https://otlp.nr-data.net

# Set by the deployment script from the Git commit.
APP_VERSION=local
VCS_REPOSITORY_URL=https://github.com/ayim/vendure
VCS_REF_NAME=master
VCS_REF_REVISION=local
